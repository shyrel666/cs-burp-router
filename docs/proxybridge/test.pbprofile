{
  "Version": "1.0",
  "Name": "Profile Format Test",
  "IsTrafficLoggingEnabled": true,
  "AutoClearConnectionLogs": true,
  "LogEveryConnection": false,
  "Language": "en",
  "CloseToTray": true,
  "FontZoom": 100,
  "NextProxyConfigId": 2,
  "ProxyConfigs": [
    {
      "Id": 1,
      "Name": "Local SOCKS5 sample",
      "Type": "SOCKS5",
      "Host": "127.0.0.1",
      "Port": "19080",
      "Username": "",
      "Password": "",
      "SendDomainToProxy": true
    }
  ],
  "ProxyRules": [
    {
      "Name": "Disabled SOCKS5 format test",
      "ProcessName": "proxybridge-profile-test.exe",
      "TargetHosts": "*",
      "TargetPorts": "443",
      "TargetDomains": "proxybridge-profile-test.invalid",
      "Protocol": "TCP",
      "Action": "PROXY",
      "IsEnabled": false,
      "LocalhostViaProxy": false,
      "ProxyConfigId": 1
    }
  ],
  "LogFilters": []
}
